---
---
<div id="search-modal" class="search-modal" hidden role="dialog" aria-modal="true" aria-label="Search docs">
  <div class="search-backdrop"></div>
  <div class="search-card">
    <div class="search-input-row">
      <span class="search-input-icon">⌕</span>
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="Search docs…"
        autocomplete="off"
        spellcheck="false"
        aria-autocomplete="list"
        aria-controls="search-results"
      />
      <kbd class="search-esc-hint">Esc</kbd>
    </div>
    <div id="search-results" class="search-results" role="listbox"></div>
    <div id="search-status" class="search-status" aria-live="polite"></div>
  </div>
</div>

<script>
  type PagefindModule = {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  };
  type PagefindResult = { data: () => Promise<PagefindData> };
  type PagefindData = {
    url: string;
    excerpt: string;
    meta: { title?: string; section?: string };
  };

  let pagefind: PagefindModule | null = null;
  let pagefindState: 'idle' | 'loading' | 'ready' | 'unavailable' = 'idle';

  async function loadPagefind() {
    if (pagefindState !== 'idle') return;
    pagefindState = 'loading';
    try {
      // new Function hides the import from Vite's AST-based import analyzer in dev mode
      const pf = await (new Function('return import("/pagefind/pagefind.js")')());
      await pf.init();
      pagefind = pf;
      pagefindState = 'ready';
    } catch {
      pagefindState = 'unavailable';
    }
  }

  function initSearch() {
    const modal    = document.getElementById('search-modal') as HTMLElement | null;
    const input    = document.getElementById('search-input') as HTMLInputElement | null;
    const results  = document.getElementById('search-results') as HTMLElement | null;
    const status   = document.getElementById('search-status') as HTMLElement | null;
    const backdrop = modal?.querySelector('.search-backdrop') as HTMLElement | null;

    if (!modal || !input || !results || !status) return;

    let selectedIndex = -1;
    let debounceTimer: ReturnType<typeof setTimeout>;

    function openModal() {
      modal.hidden = false;
      requestAnimationFrame(() => {
        modal.classList.add('is-open');
        input.focus();
      });
      document.body.style.overflow = 'hidden';
      input.value = '';
      results.innerHTML = '';
      status.textContent = '';
      selectedIndex = -1;
      loadPagefind();
    }

    function closeModal() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => { modal.hidden = true; }, 150);
    }

    function humanizeSection(s: string) {
      return s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    }

    function updateSelection(newIndex: number) {
      const items = results.querySelectorAll<HTMLElement>('.search-result-item');
      items.forEach((el, i) => el.setAttribute('aria-selected', String(i === newIndex)));
      items[newIndex]?.scrollIntoView({ block: 'nearest' });
      if (items[newIndex]) input.setAttribute('aria-activedescendant', `sr-${newIndex}`);
      selectedIndex = newIndex;
    }

    function renderResults(items: PagefindData[]) {
      results.innerHTML = '';
      selectedIndex = -1;
      if (!items.length) {
        status.textContent = 'No results found.';
        return;
      }
      status.textContent = '';
      items.forEach((item, i) => {
        const el = document.createElement('a');
        el.className = 'search-result-item';
        el.href = item.url;
        el.setAttribute('role', 'option');
        el.setAttribute('id', `sr-${i}`);
        el.setAttribute('aria-selected', 'false');
        const section = humanizeSection(item.meta?.section ?? '');
        const title = (item.meta?.title ?? 'Untitled').replace(' — Alloy Developer Docs', '');
        el.innerHTML = `
          ${section ? `<span class="search-result-section">${section}</span>` : ''}
          <span class="search-result-title">${title}</span>
          <span class="search-result-excerpt">${item.excerpt}</span>
        `;
        el.addEventListener('click', closeModal);
        results.appendChild(el);
      });
    }

    async function runSearch(query: string) {
      clearTimeout(debounceTimer);
      if (!query.trim()) {
        results.innerHTML = '';
        status.textContent = '';
        return;
      }
      if (pagefindState === 'unavailable') {
        status.textContent = 'Search is not available in dev mode — run npm run build first.';
        return;
      }
      if (pagefindState !== 'ready') {
        status.textContent = 'Loading search…';
        return;
      }
      debounceTimer = setTimeout(async () => {
        const search = await pagefind!.search(query);
        const data = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
        renderResults(data);
      }, 120);
    }

    input.addEventListener('input', (e) => {
      runSearch((e.target as HTMLInputElement).value);
    });

    modal.addEventListener('keydown', (e) => {
      const items = results.querySelectorAll<HTMLElement>('.search-result-item');
      if (e.key === 'Escape') { e.preventDefault(); closeModal(); return; }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateSelection(Math.min(selectedIndex + 1, items.length - 1));
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateSelection(Math.max(selectedIndex - 1, 0));
        return;
      }
      if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        (items[selectedIndex] as HTMLAnchorElement).click();
      }
    });

    backdrop?.addEventListener('click', closeModal);

    (window as any).__openSearch = openModal;
  }

  document.addEventListener('astro:page-load', initSearch);
</script>
