---
---
<header class="topbar" transition:persist="topbar">
  <a href="/" class="topbar-logo">
    <img src="/logo.svg" style="height: 40px" alt="Alloy" />
  </a>
  <div class="topbar-right">
    <button class="topbar-search" aria-label="Search">
      <span class="topbar-search-icon">⌕</span>
      <span>Search</span>
      <span style="opacity:0.5;font-size:11px;margin-left:8px">⌘K</span>
    </button>
    <!-- <span class="version-badge">v1.0</span> -->
    <!-- <a href="#" class="login-btn">Log In</a> -->
  </div>
</header>

<script>
  // Global ⌘K / Ctrl+K shortcut — wire once since document persists across navigations
  if (!document.body.dataset.searchKeyWired) {
    document.body.dataset.searchKeyWired = '1';
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        (window as any).__openSearch?.();
      }
    });
  }

  // Wire the topbar button — guard re-bind since topbar is transition:persist
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLElement>('.topbar-search');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = '1';
    btn.addEventListener('click', () => (window as any).__openSearch?.());
  });
</script>
