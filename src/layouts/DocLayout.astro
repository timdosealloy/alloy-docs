---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Topbar from '../components/Topbar.astro';
import Tabbar from '../components/Tabbar.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import SearchModal from '../components/SearchModal.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  headings: Heading[];
  activeTab: string;
  activeSlug: string;
  breadcrumb?: { label: string; href?: string }[];
}

const { title, headings, activeTab, activeSlug, breadcrumb = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Alloy Developer Docs</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <script src="https://kit.fontawesome.com/b1773cbbfc.js" crossorigin="anonymous"></script>
    <ViewTransitions />
    <slot name="head" />
  </head>
  <body data-active-tab={activeTab} data-active-slug={activeSlug}>

    <Topbar />
    <Tabbar activeTab={activeTab} />

    <!-- Three-column layout -->
    <div class="doc-layout">
      <LeftSidebar activeTab={activeTab} activeSlug={activeSlug} />

      <div hidden data-pagefind-meta={`section:${activeTab}`}></div>
      <main class="doc-content" id="content" data-pagefind-body>
        {breadcrumb.length > 0 && (
          <nav class="breadcrumb" aria-label="Breadcrumb">
            {breadcrumb.map((crumb, i) => (
              <>
                {i > 0 && <span class="breadcrumb-sep">›</span>}
                {crumb.href
                  ? <a href={crumb.href}>{crumb.label}</a>
                  : <span>{crumb.label}</span>
                }
              </>
            ))}
          </nav>
        )}

        <slot />
      </main>

      <RightSidebar headings={headings} />
    </div>

    <SearchModal />
  </body>
</html>

<script>
  function updateActiveState() {
    let tab = document.body.dataset.activeTab ?? '';
    if (!tab && window.location.pathname.includes('/docs/stub')) {
      tab = new URLSearchParams(window.location.search).get('tab') ?? '';
    }
    document.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
    document.querySelector(`.tab[data-tab="${tab}"]`)?.classList.add('active');
    document.querySelectorAll('.sidebar-section').forEach((s) => s.classList.remove('active'));
    document.getElementById(`nav-${tab}`)?.classList.add('active');
  }

  document.addEventListener('astro:page-load', updateActiveState);

</script>
