---
import { getCollection } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getTabForSlug } from '../../nav.ts';
import Image from '../../components/Image.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const slug = entry.slug;
const activeTab = getTabForSlug(slug);
const { title, section, navGroup } = entry.data;

const breadcrumb = [
  { label: section.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()) },
  ...(navGroup ? [{ label: navGroup }] : []),
  { label: title },
];
---

<DocLayout
  title={title}
  headings={headings}
  activeTab={activeTab}
  activeSlug={slug}
  breadcrumb={breadcrumb}
>
  <h1>{title}</h1>
  <Content components={{ Image }} />
</DocLayout>
